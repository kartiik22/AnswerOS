PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/DB_NAME

# Hugging Face — embeddings (Inference API)
HUGGINGFACE_API_KEY=hf_xxxxxxxx
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Pinecone — vector store (index dim must match embedding model: 384 for MiniLM)
PINECONE_API_KEY=pcsk_xxxxxxxx
PINECONE_INDEX=your-index-name
PINECONE_NAMESPACE=

# Groq — chat LLM via LangChain (@langchain/groq)
GROQ_API_KEY=gsk_xxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b


# Cloudinary
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
CLOUD_NAME=your_cloudinary_cloud_name
FOLDER_NAME=Embedding

# Kafka (e.g., Aiven / Cloud with SASL)
KAFKA_BROKERS=kafka-5ce6b2-aipro.j.aivencloud.com:13904
KAFKA_CLIENT_ID=simple-express-server
KAFKA_GROUP_ID=rag-worker-group
KAFKA_TOPIC=docs.uploaded
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=your_aiven_password

# Paste Aiven CA certificate inline enclosed in quotes:
KAFKA_CA_CERT="-----BEGIN CERTIFICATE-----
PASTE_YOUR_AIVEN_CA_CERTIFICATE_CONTENT_HERE
-----END CERTIFICATE-----"